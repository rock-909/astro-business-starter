{
  "name": "astro-business-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1",
    "npm": ">=11.17.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "build:test": "node scripts/build-test.mjs",
    "check": "node --input-type=module -e \"await import('@astrojs/check')\" && astro check",
    "readiness": "node scripts/readiness.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check && npm run build:test && npm test && npm run test:browser"
  },
  "dependencies": {
    "astro": "7.4.2",
    "@astrojs/cloudflare": "14.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@emnapi/runtime": "1.11.3",
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "wrangler": "4.153.0"
  }
}
