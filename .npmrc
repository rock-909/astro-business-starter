# Project install policy; overrides user-level ~/.npmrc. See .claude/rules/dependencies.md.
# Enforce real peer ranges so local `npm ci` fails the same way CI does.
legacy-peer-deps=false
# Release cooldown: only resolve versions published at least 1 day (24h) ago.
min-release-age=1
# Astro's own release family is exempt from the cooldown.
min-release-age-exclude[]=astro
min-release-age-exclude[]=@astrojs/*
