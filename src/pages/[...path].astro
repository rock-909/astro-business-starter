---
import SiteLayout from '../layouts/SiteLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import StaticContent from '../components/content/StaticContent.astro';
import FaqSection from '../components/content/FaqSection.astro';
import {
  locales,
  pages,
  site,
  messages,
  pathFor,
  pageContent,
  type Locale,
  type PageKey,
  type PageKind,
} from '../site';

export const prerender = true;
export function getStaticPaths() {
  return locales.flatMap((locale) =>
    pages.map(({ key }) => ({
      params: { path: pathFor(locale, key).slice(1) || undefined },
      props: { locale, page: key },
    })),
  );
}
const { locale, page } = Astro.props as { locale: Locale; page: PageKey };
const t = messages(locale);
// Widened on purpose: a derived site may register kinds the template does not use.
const kind = pages.find((item) => item.key === page)!.kind as PageKind;
const content = page === 'home' ? undefined : pageContent(locale, page);
// Each language titles its own home page; the identity default is only the fallback.
const title = content?.metadata.seo.title || t.home.metadata.title || site.seo.defaultTitle;
const description = content?.metadata.seo.description || t.home.metadata.description;
const address = [
  site.company?.location?.address,
  site.company?.location?.city,
  site.company?.location?.country,
]
  .filter(Boolean)
  .join(', ');
// Without any configured method the whole block stays out, like the reference site.
const hasContactMethods = Boolean(
  site.contact.email || site.contact.phone || site.contact.whatsapp || address,
);
---

<SiteLayout locale={locale} page={page} title={title} description={description}>
  {kind === 'home' ? (
    <section class="page-narrow home">
      <h1>{t.home.title}</h1>
      <p class="page-description">{t.home.description}</p>
      <a class="text-link home-contact" href={pathFor(locale, 'contact')}>
        {t.home.contactLink}
      </a>
    </section>
  ) : (
    <div class:list={['page-narrow', { 'page-split': kind === 'contact' }]}>
      <div class="page-main">
        <header class="page-header">
          <h1>{content!.metadata.title}</h1>
          {content!.metadata.description && (
            <p class="page-description">{content!.metadata.description}</p>
          )}
        </header>
        <StaticContent content={content!.content} locale={locale} showToc={kind === 'legal'} />
        <FaqSection items={content!.metadata.faq} locale={locale} />
        {kind === 'contact' && hasContactMethods && (
          <section class="contact-methods" aria-labelledby="contact-methods">
            <h2 id="contact-methods">{t.contact.panel.contactTitle}</h2>
            {site.contact.email && (
              <a class="text-link" href={`mailto:${site.contact.email}`}>
                {site.contact.email}
              </a>
            )}
            {site.contact.phone && (
              <a class="text-link" href={`tel:${site.contact.phone}`}>
                {site.contact.phone}
              </a>
            )}
            {site.contact.whatsapp && (
              <a
                class="text-link"
                href={`https://wa.me/${site.contact.whatsapp.replace(/\D/g, '')}`}
              >
                WhatsApp {site.contact.whatsapp}
              </a>
            )}
            {address && <address>{address}</address>}
          </section>
        )}
      </div>
      {kind === 'contact' && (
        <div class="page-aside">
          <InquiryForm locale={locale} />
        </div>
      )}
    </div>
  )}
</SiteLayout>
