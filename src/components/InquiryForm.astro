---
import { messages, site, pathFor, type Locale } from '../site';
import { inquiryLimits } from '../lib/inquiry-limits';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = messages(locale).inquiry.form;
const legal = messages(locale).footer.sections.support;
// Link the policy names inside the sentence instead of repeating them after it.
const privacyNotice = t.privacyNotice.split(/(\{privacy\}|\{terms\})/);
---

<section class="inquiry-card" id="inquiry" aria-label={t.contactAriaLabel}>
  <h2>{t.title}</h2>
  <noscript>
    <p class="fallback">{t.noJsExplanation}</p>
  </noscript>
  <form
    method="post"
    action={pathFor(locale, 'contact')}
    data-inquiry-form
    data-copy={JSON.stringify(t)}
    data-locale={locale}
    data-site-key={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || ''}
    novalidate
  >
    <div class="field">
      <label for="fullName">{t.fullName}</label>
      <input
        id="fullName"
        name="fullName"
        type="text"
        autocomplete="name"
        required
        maxlength={inquiryLimits.fullName}
        aria-describedby="fullName-error"
      />
      <p class="field-error" id="fullName-error" hidden></p>
    </div>
    <div class="field">
      <label for="email">{t.email}</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        required
        maxlength={inquiryLimits.email}
        aria-describedby="email-error"
      />
      <p class="field-error" id="email-error" hidden></p>
    </div>
    <div class="field">
      <label for="message">
        {t.message} <span class="optional">({t.optional})</span>
      </label>
      <textarea
        id="message"
        name="message"
        rows="5"
        maxlength={inquiryLimits.message}
        aria-describedby="message-hint message-error"
      ></textarea>
      <p class="field-hint" id="message-hint">
        {t.messageHint}
      </p>
      <p class="field-error" id="message-error" hidden></p>
    </div>
    <div class="honeypot" aria-hidden="true">
      <label for="website">{t.website}</label>
      <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <div class="verification">
      <div data-turnstile></div>
      <p data-verification-status role="status"></p>
    </div>
    <div
      data-form-status
      class="form-status"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      tabindex="-1"
    ></div>
    <button type="submit" class="button" data-submit disabled>
      <span data-submit-label>{t.submit}</span>
    </button>
    <p class="privacy-notice">
      {privacyNotice.map((part) =>
        part === '{privacy}' ? (
          <a href={pathFor(locale, 'privacy')}>{legal.privacy}</a>
        ) : part === '{terms}' ? (
          <a href={pathFor(locale, 'terms')}>{legal.terms}</a>
        ) : (
          part
        ),
      )}
    </p>
  </form>
  {site.contact.email && (
    <p class="fallback">
      {t.noJsEmailPrefix} <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.{' '}
      {t.turnstile.rescueAfterEmail}
    </p>
  )}
</section>
<script>
  import './inquiry-browser';
</script>
