---
import { parseStaticMarkdownBlocks } from './static-markdown-blocks';
import InlineMarkdown from './InlineMarkdown.astro';
import { messages, type Locale } from '../../site';
interface Props {
  content: string;
  locale: Locale;
  showToc?: boolean;
}
const { content, locale, showToc = false } = Astro.props;
const blocks = parseStaticMarkdownBlocks(content);
// Like the reference site, the contents list names the sections (h2) only.
const tocHeadings = showToc
  ? blocks.flatMap((block) => (block.kind === 'heading' && block.level === 'h2' ? [block] : []))
  : [];
const tocLabel = messages(locale).legal.tableOfContents;
---

<div class:list={['static-content', { 'has-toc': tocHeadings.length > 0 }]}>
  {tocHeadings.length > 0 && (
    <aside class="content-toc">
      <h2>{tocLabel}</h2>
      <nav aria-label={tocLabel}>
        <ol>
          {tocHeadings.map((heading) => (
            <li>
              <a href={`#${heading.id}`}>{heading.displayText}</a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>
  )}
  <div class="prose">
    {blocks.map((block) => {
      if (block.kind === 'heading') {
        const Tag = block.level;
        return <Tag id={block.id}>{block.displayText}</Tag>;
      }
      if (block.kind === 'paragraph')
        return (
          <p>
            {block.emphasized ? (
              <strong>
                <InlineMarkdown text={block.text} locale={locale} />
              </strong>
            ) : (
              <InlineMarkdown text={block.text} locale={locale} />
            )}
          </p>
        );
      if (block.kind === 'list') {
        const Tag = block.ordered ? 'ol' : 'ul';
        return (
          <Tag>
            {block.items.map((item) => (
              <li>
                <InlineMarkdown text={item} locale={locale} />
              </li>
            ))}
          </Tag>
        );
      }
      return (
        <div class="content-table" role="region" aria-label={block.headers.join(', ')} tabindex="0">
          <table>
            <thead>
              <tr>
                {block.headers.map((header) => (
                  <th scope="col">{header}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {block.rows.map((row) => (
                <tr>
                  {block.headers.map((_, index) => (
                    <td>
                      <InlineMarkdown text={row[index] || ''} locale={locale} />
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      );
    })}
  </div>
</div>
