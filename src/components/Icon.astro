const { name } = Astro.props;
---

{name === 'whatsapp' ? (
  <svg
    class="icon"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    set:html={whatsapp}
  />
) : (
  <svg
    class="icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={outline[name]}
  />
)}
