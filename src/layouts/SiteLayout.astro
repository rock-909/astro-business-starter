---
import {
  site,
  locales,
  messages,
  pathFor,
  canonical,
  shouldIndex,
  jsonLd,
  type Locale,
  type PageKey,
} from '../site';
import '../styles/global.css';
interface Props {
  locale: Locale;
  page?: PageKey;
  title: string;
  description: string;
  notFound?: boolean;
}
const { locale, page = 'home', title, description, notFound = false } = Astro.props;
const t = messages(locale);
const url = canonical(locale, page);
const fullTitle =
  page === 'home' && !notFound
    ? site.seo.defaultTitle
    : site.seo.titleTemplate.replace('%s', title);
const otherLocale = locale === 'en' ? 'es' : 'en';
const publicGaId = /^G-[A-Z0-9]+$/.test(import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '')
  ? import.meta.env.PUBLIC_GA_MEASUREMENT_ID
  : '';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description || site.seo.defaultDescription} />
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta
        name="google-site-verification"
        content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION}
      />
    )}
    {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />
    )}
    <meta
      name="robots"
      content={
        !notFound && shouldIndex(page) ? 'index,follow,max-image-preview:large' : 'noindex,nofollow'
      }
    />
    {!notFound && (
      <>
        <link rel="canonical" href={url} />
        {locales.map((language) => (
          <link rel="alternate" hreflang={language} href={canonical(language, page)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={canonical('en', page)} />
        <meta property="og:url" content={url} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_ES'} />
        <meta property="og:locale:alternate" content={otherLocale === 'en' ? 'en_US' : 'es_ES'} />
        <meta property="og:image" content={new URL(site.brandAssets.ogImage, site.baseUrl).href} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={new URL(site.brandAssets.ogImage, site.baseUrl).href} />
        <script
          is:inline
          type="application/ld+json"
          set:html={jsonLd(locale, page, title, description)}
        />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href={site.brandAssets.favicon} />
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body
    data-locale={locale}
    data-ga-id={publicGaId}
    data-production={import.meta.env.PUBLIC_APP_ENV === 'production'}
  >
    <a class="skip-link" href="#main-content">
      {t.accessibility.skipToContent}
    </a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={pathFor(locale, 'home')}>
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M3 4h18v12H10l-5 4v-4H3z" stroke="currentColor" stroke-width="1.6" />
              <path d="M7 8h10M7 12h6" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </span>
          {site.brandAssets.logo?.status === 'ready' ? (
            <img
              src={site.brandAssets.logo.horizontal}
              width={site.brandAssets.logo.width}
              height={site.brandAssets.logo.height}
              alt={site.name}
            />
          ) : (
            <span>{site.name}</span>
          )}
        </a>
        <nav class="main-nav" aria-label={t.accessibility.mainNavigation}>
          <a
            href={pathFor(locale, 'home')}
            aria-current={page === 'home' && !notFound ? 'page' : undefined}
          >
            {t.navigation.home}
          </a>
          <a
            href={pathFor(locale, 'contact')}
            aria-current={page === 'contact' ? 'page' : undefined}
          >
            {t.navigation.contactSales} <span aria-hidden="true">↗</span>
          </a>
        </nav>
        <nav class="language-nav" aria-label={t.navigation.language}>
          {locales.map((language) => (
            <a
              data-locale-link={language}
              href={
                notFound
                  ? language === 'en'
                    ? Astro.url.pathname.replace(/^\/es(?=\/|$)/, '') || '/'
                    : `/es${Astro.url.pathname.replace(/^\/es(?=\/|$)/, '')}`
                  : pathFor(language, page)
              }
              lang={language}
              hreflang={language}
              aria-current={language === locale ? 'page' : undefined}
            >
              {language === 'en' ? 'EN' : 'ES'}
            </a>
          ))}
        </nav>
      </div>
    </header>
    {import.meta.env.PUBLIC_APP_ENV !== 'production' && (
      <div class="wrap experiment-strip">
        <strong>{t.experiment.label}</strong> <span aria-hidden="true"> / </span>
        {t.experiment.description}
      </div>
    )}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-top">
          <div class="footer-brand">
            <span class="brand">{site.name}</span>
            <p class="footer-description">{t.navigation.siteDescription}</p>
          </div>
          <div>
            <h2 class="footer-heading">{t.footer.columns.navigation}</h2>
            <nav class="footer-links" aria-label={t.accessibility.footerNavigation}>
              <a href={pathFor(locale, 'home')}>{t.footer.sections.navigation.home}</a>
              <a href={pathFor(locale, 'contact')}>{t.footer.sections.navigation.contact}</a>
            </nav>
          </div>
          <div>
            <h2 class="footer-heading">{t.footer.columns.support}</h2>
            <div class="footer-links">
              <a href={pathFor(locale, 'privacy')}>{t.footer.sections.support.privacy}</a>
              <a href={pathFor(locale, 'terms')}>{t.footer.sections.support.terms}</a>
              {Object.entries(site.social)
                .filter(([, href]) => href)
                .map(([name, href]) => (
                  <a href={href} target="_blank" rel="noopener noreferrer">
                    {name} ↗
                  </a>
                ))}
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <span>
            © {new Date().getUTCFullYear()} {site.name}
          </span>
          <div class="footer-tools">
            <button type="button" class="text-button" data-open-consent>
              {t.cookie.settings}
            </button>
            <label>
              <span class="honeypot">{t.accessibility.themeSelector}</span>
              <select
                class="theme-select"
                data-theme-select
                aria-label={t.accessibility.themeSelector}
              >
                <option value="system">{t.theme.switchToSystem}</option>
                <option value="light">{t.theme.switchToLight}</option>
                <option value="dark">{t.theme.switchToDark}</option>
              </select>
            </label>
          </div>
        </div>
      </div>
    </footer>
    <section class="cookie-banner" data-cookie-banner hidden aria-label={t.cookie.title}>
      <h2>{t.cookie.title}</h2>
      <p>
        {t.cookie.description} <a href={pathFor(locale, 'privacy')}>{t.cookie.learnMore}</a>
      </p>
      <div class="cookie-choices" id="cookie-category-choices" hidden>
        <label>
          <input type="checkbox" name="analytics" data-consent-analytics />
          {t.cookie.analytics}
        </label>
        <label>
          <input type="checkbox" name="advertising" data-consent-advertising />
          {t.cookie.advertising}
        </label>
        <button type="button" class="button secondary small" data-consent-save>
          {t.cookie.saveChoices}
        </button>
      </div>
      <div class="cookie-actions">
        <button
          type="button"
          class="button secondary small"
          data-consent-customize
          aria-expanded="false"
          aria-controls="cookie-category-choices"
        >
          {t.cookie.customize}
        </button>
        <button type="button" class="button secondary small" data-consent-reject>
          {t.cookie.rejectAll}
        </button>
        <button type="button" class="button secondary small" data-consent-accept>
          {t.cookie.acceptAll}
        </button>
      </div>
    </section>
    <script>
      import '../components/site-browser';
    </script>
  </body>
</html>
