---
import {
  site,
  locales,
  defaultLocale,
  localeTable,
  pages,
  messages,
  pageContent,
  pathFor,
  canonical,
  shouldIndex,
  jsonLd,
  type Locale,
  type PageKey,
} from '../site';
import SiteHeader from '../components/SiteHeader.astro';
import Icon from '../components/Icon.astro';
import '../styles/global.css';
interface Props {
  locale: Locale;
  page?: PageKey;
  title: string;
  description: string;
  notFound?: boolean;
}
const { locale, page = 'home', title, description, notFound = false } = Astro.props;
const t = messages(locale);
const url = canonical(locale, page);
// The home page title is the whole <title>; other pages go through the template.
const fullTitle =
  page === 'home' && !notFound ? title : site.seo.titleTemplate.replace('%s', title);
// Typed wide: on a single-language site the filter would otherwise infer `never`.
const otherLocales: Locale[] = locales.filter((language) => language !== locale);
// Registered pages link themselves; a message under the column's key names the link,
// otherwise the page's own title does.
const navPages = (place: 'main' | 'support') =>
  pages.filter((item) => 'nav' in item && item.nav === place);
const navLabel = (key: PageKey, labels: Partial<Record<string, string>>) =>
  labels[key] ?? (key === 'home' ? t.navigation.home : pageContent(locale, key).metadata.title);
// Brand names for the configured social keys; they are the same in every language.
const socialNames = { linkedin: 'LinkedIn', twitter: 'X' } satisfies Record<
  keyof typeof site.social,
  string
>;
// The footer names the company when one is configured, like the reference site.
const brandName = site.company?.name?.trim() || site.name;
const { email, phone, whatsapp } = site.contact;
const address = [
  site.company?.location?.address,
  site.company?.location?.city,
  site.company?.location?.country,
]
  .map((part) => part?.trim())
  .filter(Boolean)
  .join(', ');
const socialLinks = Object.entries(site.social).filter(([, href]) => href);
const themes = [
  { key: 'system', icon: 'monitor' },
  { key: 'light', icon: 'sun' },
  { key: 'dark', icon: 'moon-star' },
] as const;
// Offered only where the page has the same content in another language (not on 404 pages).
const suggestedLocales = notFound ? [] : otherLocales;
const publicGaId = /^G-[A-Z0-9]+$/.test(import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '')
  ? import.meta.env.PUBLIC_GA_MEASUREMENT_ID
  : '';
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description || site.seo.defaultDescription} />
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta
        name="google-site-verification"
        content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION}
      />
    )}
    {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />
    )}
    <meta
      name="robots"
      content={
        !notFound && shouldIndex(page) ? 'index,follow,max-image-preview:large' : 'noindex,nofollow'
      }
    />
    {!notFound && (
      <>
        <link rel="canonical" href={url} />
        {locales.map((language) => (
          <link rel="alternate" hreflang={language} href={canonical(language, page)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={canonical(defaultLocale, page)} />
        <meta property="og:url" content={url} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:locale" content={localeTable[locale].ogLocale} />
        {otherLocales.map((language) => (
          <meta property="og:locale:alternate" content={localeTable[language].ogLocale} />
        ))}
        <meta property="og:image" content={new URL(site.brandAssets.ogImage, site.baseUrl).href} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={new URL(site.brandAssets.ogImage, site.baseUrl).href} />
        <script
          is:inline
          type="application/ld+json"
          set:html={jsonLd(locale, page, title, description)}
        />
      </>
    )}
    <link rel="icon" href={site.brandAssets.favicon} />
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body
    data-locale={locale}
    data-ga-id={publicGaId}
    data-production={import.meta.env.PUBLIC_APP_ENV === 'production'}
  >
    <a class="skip-link" href="#main-content">
      {t.accessibility.skipToContent}
    </a>
    <SiteHeader locale={locale} page={page} notFound={notFound} />
    {import.meta.env.PUBLIC_APP_ENV !== 'production' && (
      <div class="experiment-strip">
        <p class="wrap">
          <strong>{t.experiment.label}</strong> <span aria-hidden="true"> / </span>
          {t.experiment.description}
        </p>
      </div>
    )}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-top">
          <div class="footer-brand">
            <p class="footer-title">{brandName}</p>
            {(email || phone || whatsapp || address) && (
              <address class="footer-contact">
                {email && (
                  <a class="footer-link" href={`mailto:${email}`}>
                    <Icon name="mail" />
                    {/* A break point after @ so a long address wraps there first. */}
                    <span>
                      {email.slice(0, email.lastIndexOf('@') + 1)}
                      <wbr />
                      {email.slice(email.lastIndexOf('@') + 1)}
                    </span>
                  </a>
                )}
                {phone && (
                  <a class="footer-link" href={`tel:${phone}`}>
                    <Icon name="phone" />
                    {phone}
                  </a>
                )}
                {whatsapp && (
                  <a class="footer-link" href={`https://wa.me/${whatsapp.replace(/\D/g, '')}`}>
                    <Icon name="whatsapp" />
                    WhatsApp {whatsapp}
                  </a>
                )}
                {address && (
                  <p>
                    <Icon name="map-pin" />
                    {address}
                  </p>
                )}
              </address>
            )}
          </div>
          <nav class="footer-columns" aria-label={t.accessibility.footerNavigation}>
            <div>
              <h2 class="footer-title">{t.footer.columns.navigation}</h2>
              <ul class="footer-links">
                {navPages('main').map(({ key }) => (
                  <li>
                    <a class="footer-link" href={pathFor(locale, key)}>
                      {navLabel(key, t.footer.sections.navigation)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h2 class="footer-title">{t.footer.columns.support}</h2>
              <ul class="footer-links">
                {navPages('support').map(({ key }) => (
                  <li>
                    <a class="footer-link" href={pathFor(locale, key)}>
                      {navLabel(key, t.footer.sections.support)}
                    </a>
                  </li>
                ))}
                {/* Hidden until the script runs, so visitors without JavaScript are not offered it. */}
                <li data-open-consent-item hidden>
                  <button type="button" class="footer-link" data-open-consent>
                    {t.cookie.settings}
                  </button>
                </li>
              </ul>
            </div>
            {socialLinks.length > 0 && (
              <div>
                <h2 class="footer-title">{t.footer.columns.social}</h2>
                <ul class="footer-links">
                  {socialLinks.map(([name, href]) => (
                    <li>
                      <a class="footer-link" href={href} target="_blank" rel="noopener noreferrer">
                        {socialNames[name as keyof typeof socialNames]}{' '}
                        <span aria-hidden="true">↗</span>
                        <span class="visually-hidden">({t.accessibility.opensInNewTab})</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </nav>
        </div>
        <div class="footer-bottom">
          <p>
            © {new Date().getUTCFullYear()} {brandName}
          </p>
          {/* Script-driven like the cookie settings, so hidden without JavaScript. */}
          <div
            class="theme-switcher"
            role="group"
            aria-label={t.accessibility.themeSelector}
            data-theme-switcher
            hidden
          >
            {themes.map(({ key, icon }) => (
              <button
                type="button"
                data-theme-choice={key}
                aria-label={t.theme[key]}
                aria-pressed="false"
              >
                <Icon name={icon} />
              </button>
            ))}
          </div>
        </div>
      </div>
    </footer>
    <section class="cookie-banner" data-cookie-banner hidden aria-label={t.cookie.title}>
      <p>
        {t.cookie.description}{' '}
        <a class="text-link" href={pathFor(locale, 'privacy')}>
          {t.cookie.learnMore}
        </a>
      </p>
      {/* Customize sits on the left but comes last in the DOM, right before the options it
          reveals, so Tab moves from it straight into them. */}
      <div class="cookie-actions">
        <div class="cookie-decisions">
          <button type="button" class="button outline small" data-consent-reject>
            {t.cookie.rejectAll}
          </button>
          <button type="button" class="button outline small" data-consent-accept>
            {t.cookie.acceptAll}
          </button>
        </div>
        <button
          type="button"
          class="button outline small cookie-customize"
          data-consent-customize
          aria-expanded="false"
          aria-controls="cookie-category-choices"
        >
          {t.cookie.customize}
        </button>
      </div>
      <div class="cookie-choices" id="cookie-category-choices" hidden>
        <div class="cookie-categories">
          <label>
            <input type="checkbox" name="analytics" data-consent-analytics />
            {t.cookie.analytics}
          </label>
          <label>
            <input type="checkbox" name="advertising" data-consent-advertising />
            {t.cookie.advertising}
          </label>
        </div>
        <button type="button" class="button outline small" data-consent-save>
          {t.cookie.saveChoices}
        </button>
      </div>
    </section>
    {suggestedLocales.length > 0 && (
      <div class="language-suggestions" data-language-suggestions>
        {suggestedLocales.map((language) => {
          const copy = messages(language).languageSuggestion;
          return (
            <section
              class="language-suggestion"
              data-language-suggestion={language}
              lang={language}
              aria-label={copy.label}
              hidden
            >
              <p>{copy.message}</p>
              <a
                class="button outline small"
                data-locale-link={language}
                href={pathFor(language, page)}
                hreflang={language}
              >
                {copy.switchAction}
              </a>
              <button
                type="button"
                class="button ghost"
                data-language-dismiss
                aria-label={copy.dismiss}
              >
                <Icon name="x" />
              </button>
            </section>
          );
        })}
      </div>
    )}
    <script>
      import '../components/site-browser';
    </script>
  </body>
</html>
