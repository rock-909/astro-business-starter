---
import {
  site,
  locales,
  defaultLocale,
  localeTable,
  pages,
  messages,
  pageContent,
  pathFor,
  canonical,
  shouldIndex,
  jsonLd,
  localizedPath,
  unlocalizedPath,
  type Locale,
  type PageKey,
} from '../site';
import '../styles/global.css';
interface Props {
  locale: Locale;
  page?: PageKey;
  title: string;
  description: string;
  notFound?: boolean;
}
const { locale, page = 'home', title, description, notFound = false } = Astro.props;
const t = messages(locale);
const url = canonical(locale, page);
// The home page title is the whole <title>; other pages go through the template.
const fullTitle =
  page === 'home' && !notFound ? title : site.seo.titleTemplate.replace('%s', title);
// Typed wide: on a single-language site the filter would otherwise infer `never`.
const otherLocales: Locale[] = locales.filter((language) => language !== locale);
// Registered pages link themselves; a message under the column's key names the link,
// otherwise the page's own title does.
const navPages = (place: 'main' | 'support') =>
  pages.filter((item) => 'nav' in item && item.nav === place);
const navLabel = (key: PageKey, labels: Partial<Record<string, string>>) =>
  labels[key] ?? (key === 'home' ? t.navigation.home : pageContent(locale, key).metadata.title);
// Brand names for the configured social keys; they are the same in every language.
const socialNames = { linkedin: 'LinkedIn', twitter: 'X' } satisfies Record<
  keyof typeof site.social,
  string
>;
const publicGaId = /^G-[A-Z0-9]+$/.test(import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '')
  ? import.meta.env.PUBLIC_GA_MEASUREMENT_ID
  : '';
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description || site.seo.defaultDescription} />
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta
        name="google-site-verification"
        content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION}
      />
    )}
    {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
      <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />
    )}
    <meta
      name="robots"
      content={
        !notFound && shouldIndex(page) ? 'index,follow,max-image-preview:large' : 'noindex,nofollow'
      }
    />
    {!notFound && (
      <>
        <link rel="canonical" href={url} />
        {locales.map((language) => (
          <link rel="alternate" hreflang={language} href={canonical(language, page)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={canonical(defaultLocale, page)} />
        <meta property="og:url" content={url} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:locale" content={localeTable[locale].ogLocale} />
        {otherLocales.map((language) => (
          <meta property="og:locale:alternate" content={localeTable[language].ogLocale} />
        ))}
        <meta property="og:image" content={new URL(site.brandAssets.ogImage, site.baseUrl).href} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={new URL(site.brandAssets.ogImage, site.baseUrl).href} />
        <script
          is:inline
          type="application/ld+json"
          set:html={jsonLd(locale, page, title, description)}
        />
      </>
    )}
    <link rel="icon" href={site.brandAssets.favicon} />
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body
    data-locale={locale}
    data-ga-id={publicGaId}
    data-production={import.meta.env.PUBLIC_APP_ENV === 'production'}
  >
    <a class="skip-link" href="#main-content">
      {t.accessibility.skipToContent}
    </a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={pathFor(locale, 'home')}>
          {site.brandAssets.logo?.status === 'ready' ? (
            <img
              src={site.brandAssets.logo.horizontal}
              width={site.brandAssets.logo.width}
              height={site.brandAssets.logo.height}
              alt={site.name}
            />
          ) : (
            <>
              {/* The template mark stands in only until a derived site configures its own logo. */}
              <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M3 4h18v12H10l-5 4v-4H3z" stroke="currentColor" stroke-width="1.6" />
                  <path d="M7 8h10M7 12h6" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </span>
              <span>{site.name}</span>
            </>
          )}
        </a>
        <nav class="main-nav" aria-label={t.accessibility.mainNavigation}>
          {navPages('main').map(({ key }) => (
            <a
              href={pathFor(locale, key)}
              aria-current={page === key && !notFound ? 'page' : undefined}
            >
              {navLabel(key, { contact: t.navigation.contactSales })}
            </a>
          ))}
        </nav>
        {/* A single-language site has nothing to switch to. */}
        {locales.length > 1 && (
          <nav class="language-nav" aria-label={t.navigation.language}>
            {locales.map((language) => (
              <a
                data-locale-link={language}
                href={
                  notFound
                    ? localizedPath(language, unlocalizedPath(Astro.url.pathname))
                    : pathFor(language, page)
                }
                lang={language}
                hreflang={language}
                aria-current={language === locale ? 'page' : undefined}
                aria-label={localeTable[language].name}
              >
                {localeTable[language].label}
              </a>
            ))}
          </nav>
        )}
      </div>
    </header>
    {import.meta.env.PUBLIC_APP_ENV !== 'production' && (
      <div class="wrap experiment-strip">
        <strong>{t.experiment.label}</strong> <span aria-hidden="true"> / </span>
        {t.experiment.description}
      </div>
    )}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-top">
          <div class="footer-brand">
            <span class="brand">{site.name}</span>
            <p class="footer-description">{t.navigation.siteDescription}</p>
          </div>
          <div>
            <h2 class="footer-heading">{t.footer.columns.navigation}</h2>
            <nav class="footer-links" aria-label={t.accessibility.footerNavigation}>
              {navPages('main').map(({ key }) => (
                <a href={pathFor(locale, key)}>{navLabel(key, t.footer.sections.navigation)}</a>
              ))}
            </nav>
          </div>
          <div>
            <h2 class="footer-heading">{t.footer.columns.support}</h2>
            <div class="footer-links">
              {navPages('support').map(({ key }) => (
                <a href={pathFor(locale, key)}>{navLabel(key, t.footer.sections.support)}</a>
              ))}
              {Object.entries(site.social)
                .filter(([, href]) => href)
                .map(([name, href]) => (
                  <a href={href} target="_blank" rel="noopener noreferrer">
                    {socialNames[name as keyof typeof socialNames]}{' '}
                    <span aria-hidden="true">↗</span>
                    <span class="visually-hidden">({t.accessibility.opensInNewTab})</span>
                  </a>
                ))}
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <span>
            © {new Date().getUTCFullYear()} {site.name}
          </span>
          <div class="footer-tools">
            <button type="button" class="text-button" data-open-consent hidden>
              {t.cookie.settings}
            </button>
            <select
              class="theme-select"
              data-theme-select
              hidden
              aria-label={t.accessibility.themeSelector}
            >
              <option value="system">{t.theme.system}</option>
              <option value="light">{t.theme.light}</option>
              <option value="dark">{t.theme.dark}</option>
            </select>
          </div>
        </div>
      </div>
    </footer>
    <section class="cookie-banner" data-cookie-banner hidden aria-label={t.cookie.title}>
      <h2>{t.cookie.title}</h2>
      <p>
        {t.cookie.description}{' '}
        <a class="text-link" href={pathFor(locale, 'privacy')}>
          {t.cookie.learnMore}
        </a>
      </p>
      <div class="cookie-actions">
        <button type="button" class="button outline small" data-consent-reject>
          {t.cookie.rejectAll}
        </button>
        <button type="button" class="button outline small" data-consent-accept>
          {t.cookie.acceptAll}
        </button>
        <button
          type="button"
          class="button outline small"
          data-consent-customize
          aria-expanded="false"
          aria-controls="cookie-category-choices"
        >
          {t.cookie.customize}
        </button>
      </div>
      <div class="cookie-choices" id="cookie-category-choices" hidden>
        <label>
          <input type="checkbox" name="analytics" data-consent-analytics />
          {t.cookie.analytics}
        </label>
        <label>
          <input type="checkbox" name="advertising" data-consent-advertising />
          {t.cookie.advertising}
        </label>
        <button type="button" class="button outline small" data-consent-save>
          {t.cookie.saveChoices}
        </button>
      </div>
    </section>
    <script>
      import '../components/site-browser';
    </script>
  </body>
</html>
