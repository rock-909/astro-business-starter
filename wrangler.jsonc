{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker's identity in the Cloudflare account: a derived site needs its own name,
  // or its deploy replaces another site's Worker and inherits its secrets (readiness checks).
  "name": "astro-business-starter",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  // Serve dist/client/contact/index.html at /contact, matching trailingSlash: 'never'
  // and the canonical URLs; Cloudflare's default would 307 /contact to /contact/.
  "assets": { "html_handling": "drop-trailing-slash" },
  // Keep the Worker's own console lines (reference IDs and categories, never buyer
  // fields) as the delivery record; request-level invocation logs and traces stay off.
  // Retention and cost: LAUNCH.md.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Cheap per-location pre-check before the paid Upstash call; Upstash keeps the exact
  // 10/minute count. namespace_id must be unique per Cloudflare account: LAUNCH.md.
  "ratelimits": [
    {
      "name": "INQUIRY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // A derived site declares its production domain here so every deploy keeps it, and
  // turns off the public *.workers.dev copy and preview URLs (LAUNCH.md section 4):
  // "routes": [{ "pattern": "www.example.com", "custom_domain": true }],
  // "workers_dev": false,
  // "preview_urls": false,
}
